{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@sugar-cypher/shared": ["packages/shared/src/index.ts"],
      "@sugar-cypher/sugar-intel": ["packages/sugar-intel/src/index.ts"],
      "@sugar-cypher/api-client": ["packages/api-client/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  }
}
